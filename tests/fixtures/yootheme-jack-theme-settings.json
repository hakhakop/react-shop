{
  "style": "jack-baker",
  "site": {
    "layout": "full",
    "toolbar_width": "default",
    "toolbar_center": true,
    "boxed": { "alignment": 1 }
  },
  "header": {
    "layout": "horizontal-center",
    "width": "expand",
    "search_layout": "input-dropdown",
    "search_dropdown.stretch": "navbar",
    "search_dropdown.size": true,
    "search_icon": "left",
    "search": "",
    "social_gap": "small",
    "social_style": false,
    "social": "",
    "logo_padding_remove": false
  },
  "navbar": {
    "sticky": 2,
    "dropdown_align": "left",
    "dropbar": true,
    "dropdown_boundary": false
  },
  "dialog": {
    "layout": "offcanvas-top",
    "toggle": "header:end",
    "menu_style": "default",
    "offcanvas": {
      "mode": "slide",
      "flip": true,
      "overlay": true
    }
  },
  "mobile": {
    "breakpoint": "l",
    "header": {
      "layout": "horizontal-right",
      "search_layout": "input-dropdown",
      "search_dropdown.stretch": "navbar",
      "search_dropdown.size": true,
      "search_icon": "left",
      "social_style": false,
      "social_gap": "small",
      "social": "",
      "social_items": [
        { "link": "https://500px.com/" },
        { "link": "https://www.instagram.com/" },
        { "link": "https://www.facebook.com/yootheme" }
      ]
    },
    "navbar": { "sticky": 0 },
    "dialog": {
      "layout": "modal-center",
      "toggle": "header-mobile:end",
      "close": true,
      "menu_style": "default",
      "offcanvas": { "mode": "push", "flip": false },
      "dropbar": { "animation": "reveal-top" },
      "text_center": true,
      "push_index": 2
    },
    "search": "right",
    "offcanvas": { "overlay": true }
  },
  "logo": {
    "text": "Jack Baker",
    "image": "wp-content/uploads/yootheme/logo.svg",
    "image_inverse": "",
    "image_mobile": "wp-content/uploads/yootheme/logo-mobile.svg",
    "image_svg_inline": true,
    "image_dialog": ""
  },
  "menu": {
    "items": {
      "30": {
        "dropdown": { "columns": 1 }
      }
    },
    "positions": {
      "navbar": {
        "style": "default",
        "image_margin": true,
        "image_align": "center",
        "menu": 2
      },
      "dialog-mobile": {
        "style": "primary",
        "image_margin": true,
        "image_align": "center",
        "menu": 4,
        "divider": false
      }
    }
  }
}
